{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        },
        "type": "small"
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "keyWidth": 10,
            "format": "         {6}{7}{8}"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "os",
            "key": "󰌽 ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "key": "󰍹 ",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "magenta",
            "format": "{1} / {2}"
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "blue",
            "format": "{1} / {2} ({3}%)"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "key": " ",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "󰍹 ",
            "keyColor": "green"
        },
        {
            "type": "host",
            "key": "󰒋 ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󰔛 ",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "󰁹 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "yellow"
        },
        {
            "type": "localip",
            "key": "󰅜 ",
            "keyColor": "blue"
        },
        {
            "type": "wifi",
            "key": "󰤨 ",
            "keyColor": "cyan"
        },
        {
            "type": "sound",
            "key": "󰕾 ",
            "keyColor": "magenta"
        },
        {
            "type": "player",
            "key": "󰎈 ",
            "keyColor": "green"
        },
        {
            "type": "datetime",
            "key": "󰃰 ",
            "keyColor": "blue",
            "format": "%Y-%m-%d %H:%M:%S"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
        "break"
    ]
}
